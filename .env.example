# --- LLM providers (add at least one; more = better fallback) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# --- Tools ---
TAVILY_API_KEY=
BRAVE_API_KEY=
FINNHUB_API_KEY=
HF_TOKEN=

# --- Infra (optional) ---
# Upstash Redis (Vercel Marketplace sets KV_REST_API_* automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DASHASHAM_API_KEY=      # if set, clients must send x-api-key
CRON_SECRET=            # Vercel sends this as Bearer to cron routes

# --- Optional model overrides: provider:model,provider:model ---
